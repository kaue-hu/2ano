*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Ganeva,
    Verdana, sans-serif;
}




body {
    background-color: #ffe556;
    color: #c8412d;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
    text-align: center;
}




h1 {
    color: #00bcf0;
    font-size: 2rem;
    margin-bottom: 8px;
}


p {
    color: #555555;
    font-size: 1rem;
    margin-bottom: 25px;
}


button {
    background-color: red;
    color: white;
    border: none;
    padding: 14px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2 ease, transform 0.1s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}
